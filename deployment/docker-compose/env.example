# Sovren exchange full node — compose environment (mainnet values).
# cp env.example .env, then fill the two host paths.
# SEEDS / PERSISTENT_PEERS below are copied from network/mainnet/peers.txt;
# regenerate with `sovren-manifest generate` rather than editing here.

# Image + digest are published per release (see ../kubernetes/README.md, plan
# D4). Always pin by digest in production:
#   SOVR_NODE_IMAGE=ghcr.io/sovrn-tech/sovrd@sha256:<release digest>
SOVR_NODE_IMAGE=ghcr.io/sovrn-tech/sovrd:latest

DEPLOYMENT_ENVIRONMENT=mainnet
CHAIN_ID=sovr-1
MONIKER=sovren-exchange-fullnode

SEEDS=381af5e4d0d5e24af3bb4d506b06081399622d01@seed1.mainnet.sovrchain.net:32000,68d9058a5dd7062d72d917ae8f2a2e30101b5a74@seed2.mainnet.sovrchain.net:32001
PERSISTENT_PEERS=24ebffde61a15df70687df28d9d9259dcb4beb64@sentry1a.mainnet.sovrchain.net:32200,6ee852fb24a636109f49a6b7184c8533d60d71ae@sentry1b.mainnet.sovrchain.net:32201,f9f287196905f574334d87370ee28369814a01eb@sentry2a.mainnet.sovrchain.net:32220,d41608b237019c09281c9542bbe90532b03b65ea@sentry2b.mainnet.sovrchain.net:32221,b8c805f050e090edf52fcd5169e239826ffb21a5@sentry3a.mainnet.sovrchain.net:32240,a49544b198f062c893b849a37389a227a51b40d4@sentry3b.mainnet.sovrchain.net:32241

# Public address peers can dial back on (leave empty behind NAT without a
# stable address):
#   EXTERNAL_ADDRESS=tcp://<your-public-ip-or-dns>:26656
EXTERNAL_ADDRESS=

# Host paths.
HOST_SOVR_HOME=./data/sovr
HOST_RELEASE_BUNDLE_DIR=./release

# Resource limits (see docs/node-operations.md sizing table).
MEMORY_LIMIT=4g
CPU_LIMIT=2
